# Copy this file to .env and adjust as needed.
# .env is gitignored - never commit real secrets.

# --- Database (XAMPP defaults) ---
# XAMPP's MySQL normally runs on 127.0.0.1:3306 with user "root"
# and NO password out of the box. Change these if you set a
# root password in phpMyAdmin > User accounts.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fixit_pdas

# --- Auth ---
# Generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=2b1a82483ddaad38790dbb6ea7d6be591adbc946fc36fcd325fbe9711d18b0ab2bb7abe7519e2ab24140d6b173eec635
JWT_EXPIRES_IN=1d

# --- Server ---
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# --- Used only by `npm run seed:admin` ---
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
ADMIN_EMAIL=admin@isatu.edu.ph
ADMIN_PASSWORD=ChangeMe@123
