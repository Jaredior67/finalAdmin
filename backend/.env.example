# Copy this file to .env and adjust as needed.
# .env is gitignored - never commit real secrets.

# --- Database (XAMPP defaults) ---
# XAMPP's MySQL normally runs on 127.0.0.1:3306 with user "root"
# and NO password out of the box. Change these if you set a
# root password in phpMyAdmin > User accounts.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fixit_pdas

# --- Auth ---
# Generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Paste the output below (never commit a real secret — this file is public).
JWT_SECRET=PASTE_GENERATED_96_HEX_CHARS_HERE
JWT_EXPIRES_IN=8h

# --- Server ---
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# --- Used only by `npm run seed:admin` ---
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
ADMIN_EMAIL=admin@isatu.edu.ph
ADMIN_PASSWORD=ChangeMe@123
