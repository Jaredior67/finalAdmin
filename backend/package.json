{
  "name": "fixit-pdas-backend",
  "version": "1.0.0",
  "description": "Backend API for FixIt PDAS (ISAT U Dumangas facility/maintenance job request system)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed:test-accounts": "node src/scripts/seedTestAccounts.js",
    "seed:all": "node src/scripts/seedAdmin.js && node src/scripts/seedTestAccounts.js",
    "test": "node --test tests/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "qrcode": "^1.5.4"
  }
}
