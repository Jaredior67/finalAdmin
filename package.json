{
  "name": "fixit-pdas-system",
  "version": "1.0.0",
  "description": "FixIt PDAS Facility and Maintenance Job Request Management System - ISAT U Dumangas Campus",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "start:backend": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "npm --prefix frontend run dev",
    "lint": "npx oxlint backend/src frontend/src",
    "check:login": "npm --prefix backend run check:login",
    "repair:roles": "npm --prefix backend run repair:roles",
    "test": "npm --prefix backend test && npm --prefix frontend test"
  },
  "dependencies": {
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
